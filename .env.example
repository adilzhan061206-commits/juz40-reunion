# Copy to .env (or set in your hosting dashboard). All values are optional in development.
APP_ENV=development                 # use "production" in production
APP_BASE_URL=http://127.0.0.1:8000  # public URL, used in e-mails and calendar links
DATABASE_URL=sqlite:///./data/app.db
AUTH_COOKIE_SECURE=false            # true behind HTTPS

# my.sdu.edu.kz integration
SDU_LOGIN_ENABLED=true
SDU_BASE_URL=https://my.sdu.edu.kz
SDU_TIMEOUT_SECONDS=25

# Registration rules
MAX_TERM_ECTS=40
MAX_SEAT_ALERTS=5
HOLD_GRACE_HOURS=24

# Demo data and administrator account
SEED_DEMO=true
ADMIN_EMAIL=admin@sdu.demo
ADMIN_PASSWORD=admin2026            # must be changed in production

# SMTP (optional) — without it e-mails are logged and shown in-app only
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
